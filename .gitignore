# Gitignore settings for ESPHome
# This is an example and may include too much for your use-case.
# You can modify this file to suit your needs.
/.esphome/
/secrets.yaml

# Local scratch / backups (not for repo)
compile.log
*.bak
radar_bak*.yaml
radar_gemini.yaml
/screenshot
/demo.mp4
tools/cache/
# 編譯時產生的位元組碼,任何深度都不要追蹤
# (舊規則 components/*/__pycache__/ 只吃一層,漏掉 components/lvgl/widgets/)
__pycache__/
.claude/
.claude/*.tmp.*
.venv
# 發佈用的韌體產物(tools/build_release.sh),不進版控
dist/

credentials.json
